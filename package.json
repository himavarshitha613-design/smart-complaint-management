{
  "name": "ai-smart-complaint-management-system",
  "version": "1.0.0",
  "description": "Full-Stack AI-Based Smart Complaint Management System with React, Node.js, Express, and MySQL",
  "type": "module",
  "workspaces": [
    "smart-complaint-frontend",
    "smart-complaint-backend"
  ],
  "scripts": {
    "build": "node build.js",
    "vercel-build": "node build.js",
    "start": "npm --prefix smart-complaint-backend start",
    "backend": "npm --prefix smart-complaint-backend start",
    "backend:dev": "npm --prefix smart-complaint-backend run dev",
    "frontend": "npm --prefix smart-complaint-frontend dev",
    "frontend:build": "npm --prefix smart-complaint-frontend run build",
    "init:db": "npm --prefix smart-complaint-backend run init-db"
  }
}
